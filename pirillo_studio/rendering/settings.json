{
  "shared": {
    "video": {
      "note": "delivery_spec.json common.video; job.py FPS. Generic delivery format; hosts inject their complete settings.",
      "codec": "h264",
      "pix_fmt": "yuv420p",
      "fps": "30/1",
      "sample_aspect_ratio": "1:1",
      "color_range": "tv",
      "color_space": "bt709",
      "color_primaries": "bt709",
      "color_transfer": "bt709",
      "sizes": {"wide": [1920, 1080], "tall": [1080, 1920]},
      "max_bytes": 8589934592
    },
    "audio": {
      "note": "delivery_spec.json common.audio: codec and sample_rate.",
      "codec": "aac",
      "sample_rate": 48000,
      "loudness_min_lufs": -16,
      "loudness_max_lufs": -12,
      "true_peak_max_dbtp": -1
    },
    "mix": {
      "version": "1",
      "voice_chain": [],
      "bed_eq": [
        "highpass=f=80",
        "lowpass=f=8000"
      ],
      "bed_loudness_lufs": -30,
      "duck": {
        "threshold": 0.015,
        "ratio": 4,
        "attack": 20,
        "release": 250,
        "makeup": 1,
        "knee": 2.8,
        "link": "average",
        "detection": "rms"
      },
      "pin": {
        "limit": 0.9,
        "attack": 5,
        "release": 50,
        "level": false
      }
    },
    "encoder": {
      "note": "encoder.py CODEC and X264: explicit portable engine and quality, never runtime fallback.",
      "engine": "libx264",
      "crf": 20,
      "preset": "veryfast"
    },
    "verification": {
      "note": "Decode the finished media; unavailable required measurements refuse. Render correspondence is required separately until its renderer exists.",
      "tools": ["ffmpeg", "ffprobe"],
      "complete_decode": true,
      "streams": {"video": 1, "audio": 1},
      "checks": ["decode", "count", "fps", "clock", "size", "codec", "color", "file_cap", "sample_rate", "loudness_lufs", "true_peak_dbtp", "av", "held_tail", "flash", "silence"],
      "render_checks": ["frame-map", "cards", "captions", "bed"],
      "master_checks": ["draft-match"]
    },
    "measurement": {
      "grid_tolerance_s": 1e-05,
      "start_tolerance_s": 0.001,
      "av_tolerance_s": 0.05,
      "gap_tolerance_s": 0.001,
      "held_difference": 0,
      "held_tail_max_s": 0.5,
      "flash_delta": 80,
      "flash_return_delta": 10,
      "silence_db": -50,
      "silence_min_s": 0.2,
      "pixel_mean_error_max": 3,
      "pixel_peak_error_max": 40,
      "bed_sample_rate": 8000,
      "bed_band_low_hz": 300,
      "bed_band_high_hz": 3000,
      "bed_window_s": 0.25,
      "bed_gain_tolerance_db": 3,
      "bed_correlation_min": 0.1,
      "bed_stem_floor_dbfs": -60,
      "audio_compare_sample_rate": 48000,
      "audio_compare_rms_tolerance": 0.01,
      "audio_compare_peak_tolerance": 0.1,
      "audio_compare_duration_tolerance_s": 0.025
    }
  },
  "profiles": {
    "arc": {"note": "draft.py arc output profile.", "groups": ["video", "audio", "mix", "encoder", "verification", "measurement"], "shape": "wide", "render_checks": []},
    "draft": {"note": "delivery_spec.json kinds.draft.", "groups": ["video", "audio", "mix", "encoder", "verification", "measurement"], "shape": "wide", "render_checks": []},
    "long": {"note": "delivery_spec.json kinds.long.", "groups": ["video", "audio", "mix", "encoder", "verification", "measurement"], "shape": "wide", "render_checks": []},
    "vertical": {"note": "delivery_spec.json kinds.vertical.", "groups": ["video", "audio", "mix", "encoder", "verification", "measurement"], "shape": "tall", "render_checks": ["subject"]},
    "short": {"note": "delivery_spec.json kinds.short.", "groups": ["video", "audio", "mix", "encoder", "verification", "measurement"], "shape": "tall", "render_checks": ["subject", "context", "word-ends"]}
  }
}
